# LinkPlease Instagram DM Automation Configuration Template

# Mock API Credentials & Configuration
API_KEY=your_api_key_here
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# User Profile Details (Used for submission script)
USER_NAME=Your Name
USER_EMAIL=you@example.com
USER_PHONE=+91...
USER_WHATSAPP=+91...
USER_LINKEDIN=https://linkedin.com/in/...
GITHUB_REPO_URL=https://github.com/yourusername/linkplease-dm-automation
