RATE_LIMIT_WINDOW_SECONDS=60

# Background Worker Settings
WORKER_POLL_INTERVAL_SECONDS=0.5
MAX_RETRY_ATTEMPTS=5
RECONCILER_INTERVAL_SECONDS=10.0
